## 一年里"该知道有这回事、但日子不固定"的节日（春节、中秋这些过农历的）
const LUNAR_HOLIDAYS := "春节、元宵、端午、七夕、中秋、重阳这些是过农历的，每年的公历日子都不一样，别随便报日期。"

## 永远都会带上的那条"世界观"：她活在什么样的世界里。
## 这几句是地基 —— 没有它，她会用不确定的年份和陌生的生活方式说话。
const WORLD := "现在是 2026 年，你在一个有网络、手机、外卖、快递的城市里生活。" \
	+ "日常用的是微信和支付宝，看视频去 B 站和抖音，出门坐地铁扫码。" \
	+ "你刚高中毕业，还没上过班、没租过房、没交过社保。"

## 一次最多注入几条常识。太多会把她"是谁"那部分冲淡
const MAX_PICK := 5

## 从这句话里挑出相关的常识条目。返回 0~MAX_PICK 条文本。
static func pick(user_text: String, month: int = 0, day: int = 0) -> Array:
	var hit: Array = []
	var text := user_text
	for e in ENTRIES:
		var keys: PackedStringArray = String(e["k"]).split(",")
		for k in keys:
			var kw := k.strip_edges()
			if kw != "" and text.find(kw) >= 0:
				hit.append(String(e["t"]))
				break
		if hit.size() >= MAX_PICK:
			break
	# 时令那两三条：命中日期就补上（不受 MAX_PICK 限制，本来就少）
	for s in SEASONAL:
		if int(s["m"]) == month and int(s["d"]) == day:
			hit.append(String(s["t"]))
	if month > 0:
		hit.append(season_line(month))
	return hit

## 当前季节的一句话（按月粗略分，不写精确节气 —— 节气日子年年差一两天）
static func season_line(month: int) -> String:
	var season := "春天"
	if month >= 6 and month <= 8:
		season = "夏天"
	elif month >= 9 and month <= 11:
		season = "秋天"
	elif month == 12 or month <= 2:
		season = "冬天"
	return "现在是%s（%d 月）。%s" % [season, month, LUNAR_HOLIDAYS]

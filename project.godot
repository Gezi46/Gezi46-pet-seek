; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PetDeek"
config/description="PetDeek：住在桌面上的蓝发女仆桌宠（Blockbench 模型 + Godot 4.7 无边框置顶窗口、拖拽、随机走动）"
run/main_scene="res://scenes/pet.tscn"
; ⚠️ use_custom_user_dir 这两行**必须留着**（2026-10-04）：
; config/name 一改，user:// 的默认目录就跟着变成 %APPDATA%\Godot\app_userdata\PetDeek\，
; 于是她的长期记忆 / 配置 / 密钥（都住在 ...\app_userdata\桌宠\）会全部"失联" ——
; 看起来就像她突然失忆 + 要重新填 key。app_userdata 下那个 "DeepSeek 酱 · 桌宠"
; 目录就是以前改名留下的残骸。
; 这两行把 user:// 钉死在原来的位置：显示名是新名字，数据目录还是老地方。
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/桌宠"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[debug]

; 把引擎自己的日志也落盘（user://logs/godot.log）——**导出版里也要**。
; 默认只在编辑器里写文件，而导出的 exe 没有控制台：脚本报错、加载失败这些东西
; 一闪就没，用户只能说"它不动了"。开了这个，那些行就留在文件里，能被「导出日志」收走。
; 桌宠自己那份（user://logs/pet.log）由 scripts/sys/pet_log.gd 写，和这里无关。
file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true

[display]

window/size/viewport_width=330
window/size/viewport_height=470
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/no_focus=true
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=3
scaling_3d/scale=2.0
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
viewport/transparent_background=true
